# Pluggy — credenciais em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Diretório onde os SQLite por-usuário ficam (um arquivo por username).
# Caminhos relativos são resolvidos a partir do cwd do processo da API
# (packages/api/ quando rodando via `npm run dev:api`). Em dev use `./data/`;
# em produção/Railway use o mount absoluto (ex: `/data/`).
DATABASE_DIR=./data/

# Credenciais multi-usuário. Cada usuário é uma var separada no formato
# USER_<NOME>_PASSWORD. O nome (em minúsculas) vira o arquivo SQLite e o
# username de login. Exemplo:
#   USER_KENJI_PASSWORD=hunter2
#   USER_ALICE_PASSWORD=correcthorse
# Se nenhuma USER_*_PASSWORD estiver definida, a app roda em modo aberto
# com um usuário "default" (apenas para dev local).

# Segredo para assinar o cookie de sessão. Obrigatório em produção.
SESSION_SECRET=

# Importar fatura por screenshots (Claude visão). Opcional: sem a key a
# feature fica desligada (o botão some no Dashboard e os endpoints respondem
# 503).
#
# ANTHROPIC_BASE_URL é opcional (aponta o SDK para um gateway). ATENÇÃO: o SDK
# já anexa `/v1/messages` à base. Para a Anthropic direta, deixe vazio. Para o
# OpenRouter use `https://openrouter.ai/api` (NÃO `/api/v1` — viraria
# `/api/v1/v1/messages` e dá 404). O código tolera um `/v1` final mesmo assim.
#
# ANTHROPIC_MODEL é opcional. Anthropic direta: `claude-sonnet-4-6`.
# Via OpenRouter use o id de lá. Precisa ser um modelo com VISÃO + tool-use:
#   - pago:   `anthropic/claude-sonnet-4.5`
#   - grátis: `google/gemma-4-31b-it:free`  (funciona, mas o tier grátis pode
#             retornar 429 "rate-limited upstream"; é só tentar de novo. Para
#             limites maiores, adicione sua própria key do provider no OpenRouter
#             em Settings → Integrations, ou use um modelo pago.)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Opcionais
PORT=3333
CORS_ORIGIN=http://localhost:5173
