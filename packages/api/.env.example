# Pluggy — credenciais em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Caminho absoluto do arquivo SQLite. Local: ./packages/api/data/finance.sqlite
# Railway/produção: /data/finance.sqlite (volume montado).
DATABASE_PATH=

# Senha de acesso à app. Se vazia, autenticação fica desabilitada (dev local).
# Em produção, defina obrigatoriamente — protege todas as rotas da API.
APP_PASSWORD=

# Opcionais
PORT=3333
CORS_ORIGIN=http://localhost:5173
